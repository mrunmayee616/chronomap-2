# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (MongoDB)
# Local mongod:
MONGODB_URI=mongodb://127.0.0.1:27017/chronomap
# MongoDB Atlas (example):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chronomap?retryWrites=true&w=majority

# Fetch real Wikipedia photos for built-in places in the background on startup.
# Set to 'off' on a server with no outbound internet.
# PLACE_IMAGE_SYNC=on
